-- ============ FILE I/O ============
local function hasFileAPI()
    return writefile ~= nil and readfile ~= nil and isfile ~= nil
end

local function saveJSON(fn, d)
    if not hasFileAPI() then return false end
    return pcall(function() writefile(fn, HttpService:JSONEncode(d)) end)
end

local function loadJSON(fn)
    if not hasFileAPI() or not isfile(fn) then return nil end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(fn)) end)
    return ok and d or nil
end

local function saveSettings() pcall(function() saveJSON(FILE_SETTINGS, Settings) end) end

local function loadSettings()
    local d = loadJSON(FILE_SETTINGS)
    if d then
        for k, v in pairs(d) do if Settings[k] ~= nil then Settings[k] = v end end
    end
end
