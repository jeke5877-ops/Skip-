-- ============ GESTURE TRACKER ============
-- Tracks each touch from start to end and classifies as tap / hold / swipe
local activeGesture = nil

local function startGesture(input)
    activeGesture = {
        x1 = input.Position.X, y1 = input.Position.Y,
        x2 = input.Position.X, y2 = input.Position.Y,
        startTime = tick(),
        moved = false,
        points = {{input.Position.X, input.Position.Y}}
    }
end

local function moveGesture(input)
    if not activeGesture then return end
    activeGesture.x2 = input.Position.X
    activeGesture.y2 = input.Position.Y
    local dx = activeGesture.x2 - activeGesture.x1
    local dy = activeGesture.y2 - activeGesture.y1
    if math.sqrt(dx * dx + dy * dy) > 40 then
        activeGesture.moved = true
    end
    table.insert(activeGesture.points, {input.Position.X, input.Position.Y})
end

local function endGesture(input)
    if not activeGesture then return end
    local g = activeGesture
    activeGesture = nil
    local duration = tick() - g.startTime
    local dx = g.x2 - g.x1
    local dy = g.y2 - g.y1
    local dist = math.sqrt(dx * dx + dy * dy)

    if g.moved and dist > 100 then
        return {type = "swipe", x1 = g.x1, y1 = g.y1, x2 = g.x2, y2 = g.y2, duration = duration}
    elseif duration > 0.4 then
        return {type = "hold"
