    SettingsTab:CreateInput({Name = name, PlaceholderText = "0", RemoveTextAfterFocusLost = false, Callback = callback})
end

coordInput("Lobby Play X", function(t) LOBBY_X = tonumber(t) or 0 end)
coordInput("Lobby Play Y", function(t) LOBBY_Y = tonumber(t) or 0 end)
coordInput("Map Select X", function(t) MAP_X = tonumber(t) or 0 end)
coordInput("Map Select Y", function(t) MAP_Y = tonumber(t) or 0 end)
coordInput("Difficulty X", function(t) DIFF_X = tonumber(t) or 0 end)
coordInput("Difficulty Y", function(t) DIFF_Y = tonumber(t) or 0 end)
coordInput("Speed X", function(t) SPEED_X = tonumber(t) or 0 end)
coordInput("Speed Y", function(t) SPEED_Y = tonumber(t) or 0 end)
coordInput("Confirm/Play X", function(t) CONFIRM_X = tonumber(t) or 0 end)
coordInput("Confirm/Play Y", function(t) CONFIRM_Y = tonumber(t) or 0 end)

SettingsTab:CreateButton({
    Name = "Test Phase Detection",
    Callback = function()
        local p = detectPhase()
        Rayfield:Notify({Title = "Phase", Content = "Detected: " .. p, Duration = 3})
    end
})

SettingsTab:CreateButton({
    Name = "Test World Raycast (center)",
    Callback = function()
        local cx, cy = Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2
        local pos = screenToWorld(cx, cy)
        if pos then
            local sx, sy = worldToScreen(pos)
            Rayfield:Notify({Title = "World Test", Content = tostring(pos) .. " -> " .. math.floor(sx) .. "," .. math.floor(sy), Duration = 4})
        else
            Rayfield:Notify({Title = "World Test", Content = "Raycast failed", Duration = 2})
        end
    end
})

-- RECORDING
UserInputService.TouchTap:Connect(function(touchPositions, processed)
    if recording and not processed then
        local pos = touchPositions[1]
        local x, y = pos.X, pos.Y
        local delay = tick() - startTime
        startTime = tick()

        local isUI = false
        for _, obj in ipairs(LP.PlayerGui:GetGuiObjectsAtPosition(x, y)) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("Frame") or obj:IsA("TextLabel") then
                isUI = true
                break
            end
        end

        if isUI or not USE_WORLD_COORDS then
            table.insert(macro, {type = "screen", x = x, y = y, delay = delay})
        else
            local worldPos = screenToWorld(x, y)
            if worldPos then
                table.insert(macro, {type = "world", pos = worldPos, delay = delay})
            else
                table.insert(macro, {type = "screen", x = x, y = y, delay = delay})
            end
        end
    end
end)

if AUTO_RUN then
    task.wait(1)
    loadedLobby = loadFrom(FILE_LOBBY) or {}
    loadedMapRoom = loadFrom(FILE_MAPROOM) or {}
    loadedGame = loadFrom(FILE_GAME) or {}
    loadedWin = loadFrom(FILE_WIN) or {}
    if #loadedLobby > 0 or #loadedMapRoom > 0 or #loadedGame > 0 then
        replaying = true
        task.spawn(function()
            local ok = pcall(fullCycle)
            replaying = false
            if not ok then Rayfield:Notify({Title = "Error", Content = "Auto-run failed", Duration = 3}) end
        end)
    end
end

Rayfield:LoadConfiguration()
