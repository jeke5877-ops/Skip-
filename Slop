-- File operations
local function saveMacro(filename, data)
    local json = HttpService:JSONEncode(data)
    if writefile then
        writefile(filename, json)
        return true
    end
    return false
end

local function loadMacro(filename)
    if readfile and isfile and isfile(filename) then
        local json = readfile(filename)
        return HttpService:JSONDecode(json)
    end
    return nil
end

-- Find button by text in PlayerGui
local function findButtonByText(text)
    for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) then
            if (gui.Text and gui.Text:lower():find(text:lower())) or (gui.Name:lower():find(text:lower())) then
                return gui
            end
        end
    end
    return nil
end

-- Click GUI button
local function clickButton(button)
    if button then
        if button:IsA("TextButton") or button:IsA("ImageButton") then
            button.MouseButton1Click:Fire()
        end
    end
end

-- Recording
local function startRecording()
    macro = {}
    recording = true
    startTime = tick()
    status.Text = "Recording..."
    recBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
end

local function stopAndSave()
    if not recording then return end
    recording = false
    status.Text = "Saving..."
    recBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    local filename = fileBox.Text
    if filename == "" then filename = "macro.json" end
    local success = saveMacro(filename, macro)
    if success then
        status.Text = "Saved " .. #macro .. " actions to " .. filename
    else
        status.Text = "Save failed (no writefile)"
    end
end

-- Replay
local function replayMacro(data)
    if not data or #data == 0 then
        status.Text = "No macro to run"
        return
    end
    replaying = true
    status.Text = "Replaying..."

    -- Apply map if enabled
    if autoMap then
        local mapText = mapBox.Text
        if mapText ~= "" then
            local mapBtn = findButtonByText(mapText)
            if mapBtn then
                clickButton(mapBtn)
                task.wait(0.5)
            end
        end
    end

    -- Apply difficulty if enabled
    if applyDifficulty then
        local diffText = diffBox.Text
        if diffText ~= "" then
            local diffBtn = findButtonByText(diffText)
            if diffBtn then
                clickButton(diffBtn)
                task.wait(0.5)
            end
        end
    end

    for _, action in ipairs(data) do
        task.wait(action.delay or 0.1)
        -- Mobile touch simulation (if mouse event fails, use SendTouchEvent)
        VirtualInputManager:SendMouseButtonEvent(action.x, action.y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(action.x, action.y, 0, false, game, 1)
    end

    replaying = false
    status.Text = "Replay finished"

    if autoLobby then
        status.Text = "Auto Lobby: Rejoining..."
        task.wait(2)
        TeleportService:Teleport(game.PlaceId, LP)
    end
end

-- Capture clicks with unit name detection
Mouse.Button1Down:Connect(function()
    if recording then
        local x, y = Mouse.X, Mouse.Y
        local delay = tick() - startTime
        startTime = tick()

        local unitName = ""
        local guiObjects = LP.PlayerGui:GetGuiObjectsAtPosition(x, y)
        for _, obj in ipairs(guiObjects) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                unitName = obj.Name
                if obj.Text and obj.Text ~= "" then
                    unitName = obj.Text
                end
                break
            end
        end

        table.insert(macro, {
            x = x,
            y = y,
            delay = delay,
            unit = unitName
        })
        status.Text = "Recorded: " .. #macro .. " | Unit: " .. (unitName ~= "" and unitName or "?")
    end
end)

-- Button events
recBtn.MouseButton1Click:Connect(function()
    if not recording then startRecording() end
end)

stopBtn.MouseButton1Click:Connect(function()
    if recording then stopAndSave() end
end)

loadBtn.MouseButton1Click:Connect(function()
    local filename = fileBox.Text
    if filename == "" then filename = "macro.json" end
    local data = loadMacro(filename)
    if data then
        loadedMacro = data
        status.Text = "Loaded " .. #loadedMacro .. " actions from " .. filename
    else
        status.Text = "Load failed (file not found)"
    end
end)

runBtn.MouseButton1Click:Connect(function()
    if not replaying and not recording then
        local data = loadedMacro
        if #data == 0 then
            local filename = fileBox.Text
            if filename == "" then filename = "macro.json" end
            data = loadMacro(filename)
            if data then loadedMacro = data end
        end
        replayMacro(data)
    end
end)

autoReplayBtn.MouseButton1Click:Connect(function()
    autoReplay = not autoReplay
    if autoReplay then
        autoReplayBtn.Text = "Auto Replay: ON"
        autoReplayBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.spawn(function()
            while autoReplay do
                if not replaying and not recording then
                    local data = loadedMacro
                    if #data == 0 then
                        local filename = fileBox.Text
                        if filename == "" then filename = "macro.json" end
                        data = loadMacro(filename)
                        if data then loadedMacro = data end
                    end
                    replayMacro(data)
                end
                task.wait(1)
            end
        end)
    else
        autoReplayBtn.Text = "Auto Replay: OFF"
        autoReplayBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    end
end)

