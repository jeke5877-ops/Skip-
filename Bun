-- Slop Tower Defense Auto Macro - Fixed based on screenshots
-- Auto replay, map voting, difficulty select, speed toggle, unit placement, defeat loop
-- For Arceus X / Delta Executor (mobile)

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
local LP = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ============ CONFIG ============
local AUTO_RUN = false
local USE_WORLD_COORDS = true
local ALLOW_DEFEAT_LOOP = true

local FILE_LOBBY = "lobby.json"
local FILE_MAPROOM = "maproom.json"
local FILE_GAME = "game.json"
local FILE_END = "end.json"

-- Manual coordinates based on screenshots
-- Lobby: not shown in screenshot, tap Play button area
local LOBBY_X, LOBBY_Y = 0, 0
-- Map voting: Space thumbnail is on the left side, second row
-- Based on screenshot 1: Space thumbnail at approximately (420, 340) on 1080p
local MAP_VOTE_X, MAP_VOTE_Y = 0, 0
-- Difficulty Select: green "Normal" card is centered, approximately (750, 450)
local DIFF_X, DIFF_Y = 0, 0
-- Speed: orange lightning :x1 icon at top-left, approximately (130, 400)
local SPEED_X, SPEED_Y = 0, 0
-- Confirm: start button after difficulty (not shown, adjust)
local CONFIRM_X, CONFIRM_Y = 0, 0
-- Defeat screen: green "Replay" button at bottom center, approximately (900, 1250)
local REPLAY_X, REPLAY_Y = 0, 0
-- Defeat screen: red "Lobby" button at bottom left, approximately (700, 1250)
local LOBBY_RETURN_X, LOBBY_RETURN_Y = 0, 0
-- ================================

local recording = false
local replaying = false
local autoReplay = false
local currentPhase = "lobby"
local macro = {}
local startTime = 0
local loadedLobby, loadedMapRoom, loadedGame, loadedEnd = {}, {}, {}, {}

-- ============ TOUCH ============
local function sendTouch(state, x, y)
    return pcall(function()
        VirtualInputManager:SendTouchEvent(0, state, x, y, 0, 0, 0)
    end)
end

local function simulateTap(x, y)
    if not x or not y or x == 0 or y == 0 then return false end
    if sendTouch(Enum.UserInputState.Begin, x, y) then
        task.wait(0.05)
        sendTouch(Enum.UserInputState.End, x, y)
        return true
    end
    return pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

local function worldToScreen(pos)
    if not Camera then return nil end
    local sp, onScreen = Camera:WorldToScreenPoint(pos)
    if onScreen then return sp.X, sp.Y end
    return nil
end

-- Raycast for ground only (reject walls)
local function screenToWorldGround(x, y)
    if not Camera then return nil end
    local ray = Camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character}
    local r = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if not r then return nil end
    if math.abs(r.Normal.Y) < 0.7 then return nil end
    return r.Position
end

-- Wait until character stops moving (map loaded)
local function waitForMapLoaded(maxSeconds)
    local waited = 0
    local stable = 0
    local lastPos = nil
    while waited < (maxSeconds or 120) do
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if lastPos and (hrp.Position - lastPos).Magnitude < 0.5 then
                    stable = stable + 1
                    if stable >= 3 then return true end
                else
                    stable = 0
                end
                lastPos = hrp.Position
            end
        end
        task.wait(1)
        waited = waited + 1
    end
    return false
end

-- ============ FILE I/O ============
local function saveTo(filename, data)
    if writefile then
        writefile(filename, HttpService:JSONEncode(data))
        return true
    end
    return false
end

local function loadFrom(filename)
    if readfile and isfile and isfile(filename) then
        return HttpService:JSONDecode(readfile(filename))
    end
    return nil
end

-- ============ REPLAY ============
local function replayPhase(data)
    for _, action in ipairs(data) do
        task.wait(action.delay or 0.1)
        if action.type == "screen" then
            simulateTap(action.x, action.y)
        elseif action.type == "world" then
            local sx, sy = worldToScreen(action.pos)
            if sx and sy then simulateTap(sx, sy) end
        end
    end
end

-- ============ FULL CYCLE ============
local function fullCycle()
    -- 1. Lobby -> Play
    if LOBBY_X ~= 0 and LOBBY_Y ~= 0 then simulateTap(LOBBY_X, LOBBY_Y) end
    replayPhase(loadedLobby)
    task.wait(3)

    -- 2. Map voting -> vote for Space (or your chosen map)
    if MAP_VOTE_X ~= 0 and MAP_VOTE_Y ~= 0 then simulateTap(MAP_VOTE_X, MAP_VOTE_Y) end
    replayPhase(loadedMapRoom)
    task.wait(2)

    -- 3. Difficulty -> Normal
    if DIFF_X ~= 0 and DIFF_Y ~= 0 then simulateTap(DIFF_X, DIFF_Y) end
    task.wait(1)

    -- 4. Speed -> x5 (tap lightning icon enough times)
    if SPEED_X ~= 0 and SPEED_Y ~= 0 then
        simulateTap(SPEED_X, SPEED_Y)
        task.wait(0.4)
        simulateTap(SPEED_X, SPEED_Y) -- x1 -> x2 -> x5 typically
    end
    task.wait(1)

    -- 5. Confirm / start
    if CONFIRM_X ~= 0 and CONFIRM_Y ~= 0 then simulateTap(CONFIRM_X, CONFIRM_Y) end
    task.wait(3)

    -- 6. Wait for map fully loaded
    if not waitForMapLoaded(180) then
        Rayfield:Notify({Title = "Error", Content = "Map load timeout", Duration = 3})
        return false
    end
    task.wait(1)

    -- 7. Game macro (units + upgrades)
    replayPhase(loadedGame)

    -- 8. Wait for end screen (fixed timeout based on average match)
    task.wait(90)

    -- 9. End screen: Replay same map (defeat loop)
    if ALLOW_DEFEAT_LOOP and REPLAY_X ~= 0 and REPLAY_Y ~= 0 then
        simulateTap(REPLAY_X, REPLAY_Y)
        task.wait(3)
    end
    replayPhase(loadedEnd)
    task.wait(5)
    return true
end

