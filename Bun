    end
})

RecordTab:CreateButton({
    Name = "Start Recording",
    Callback = function()
        if recording then return end
        macro = {}
        recording = true
        startTime = tick()
        Rayfield:Notify({Title = "Recording", Content = "Recording " .. currentPhase, Duration = 2})
    end
})

RecordTab:CreateButton({
    Name = "Stop & Save Phase",
    Callback = function()
        if not recording then return end
        recording = false
        local fname = FILE_LOBBY
        if currentPhase == "maproom" then fname = FILE_MAPROOM
        elseif currentPhase == "game" then fname = FILE_GAME
        elseif currentPhase == "end" then fname = FILE_END end
        if saveTo(fname, macro) then
            Rayfield:Notify({Title = "Saved", Content = #macro .. " actions -> " .. fname, Duration = 3})
        end
    end
})

-- RUN TAB
RunTab:CreateButton({
    Name = "Load All Phases",
    Callback = function()
        loadedLobby = loadFrom(FILE_LOBBY) or {}
        loadedMapRoom = loadFrom(FILE_MAPROOM) or {}
        loadedGame = loadFrom(FILE_GAME) or {}
        loadedEnd = loadFrom(FILE_END) or {}
        Rayfield:Notify({Title = "Loaded", Content = string.format("L:%d M:%d G:%d E:%d", #loadedLobby, #loadedMapRoom, #loadedGame, #loadedEnd), Duration = 4})
    end
})

RunTab:CreateButton({
    Name = "Run Full Cycle",
    Callback = function()
        if replaying then return end
        replaying = true
        task.spawn(function()
            local ok = pcall(fullCycle)
            replaying = false
            Rayfield:Notify({Title = "Done", Content = ok and "Cycle complete" or "Cycle failed", Duration = 2})
        end)
    end
})

RunTab:CreateToggle({
    Name = "Auto Replay Full Cycle",
    CurrentValue = false,
    Flag = "AutoFull",
    Callback = function(Value)
        autoReplay = Value
        if Value then
            task.spawn(function()
                while autoReplay do
                    if not replaying and not recording then
                        replaying = true
                        local ok = pcall(fullCycle)
                        replaying = false
                        if not ok then
                            Rayfield:Notify({Title = "Retry", Content = "Cycle failed, retrying in 10s", Duration = 3})
                            task.wait(10)
                        end
                    end
                    task.wait(2)
                end
            end)
        end
    end
})

