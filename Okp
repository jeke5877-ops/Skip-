-- Slop Tower Defense Macro Recorder with Rayfield UI (English)
-- Mobile compatible: Arceus X, Delta Executor
-- Records touches, unit names, delays; replays them. Auto map, difficulty, lobby.

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local LP = Players.LocalPlayer

local recording = false
local replaying = false
local autoReplay = false
local autoLobby = false
local autoMap = false
local applyDifficulty = false
local macro = {}
local startTime = 0
local loadedMacro = {}

-- Touch simulation with multiple fallback methods
local function simulateTouch(x, y)
    local ok = pcall(function()
        VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.Begin, x, y, 0, 0, 0)
        task.wait(0.05)
        VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.End, x, y, 0, 0, 0)
    end)
    if ok then return true end

    ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    if ok then return true end

    if tap then pcall(function() tap(x, y) end) return true end
    if touch then pcall(function() touch(x, y) end) return true end
    return false
end

-- Rayfield Window
local Window = Rayfield:CreateWindow({
    Name = "Slop TD Macro",
    LoadingTitle = "Loading...",
    LoadingSubtitle = "by seraph",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "SlopTDMacro",
        FileName = "Config"
    },
    KeySystem = false
})

local MacroTab = Window:CreateTab("Macro", 4483362458)
local SettingsTab = Window:CreateTab("Settings", 4483362458)

-- Macro Tab
local FileNameBox = MacroTab:CreateInput({
    Name = "Macro Filename",
    PlaceholderText = "macro1.json",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        _G.macroFileName = Text
    end
})

local RecordButton = MacroTab:CreateButton({
    Name = "Start Recording",
    Callback = function()
        if recording then return end
        macro = {}
        recording = true
        startTime = tick()
        Rayfield:Notify({Title = "Recording", Content = "Recording started", Duration = 2})
    end
})

local StopButton = MacroTab:CreateButton({
    Name = "Stop & Save",
    Callback = function()
        if not recording then return end
        recording = false
        local filename = _G.macroFileName or "macro.json"
        local json = HttpService:JSONEncode(macro)
        if writefile then
            writefile(filename, json)
            Rayfield:Notify({Title = "Saved", Content = "Saved " .. #macro .. " actions to " .. filename, Duration = 3})
        else
            Rayfield:Notify({Title = "Error", Content = "writefile unavailable", Duration = 3})
        end
    end
})

local LoadButton = MacroTab:CreateButton({
    Name = "Load Macro",
    Callback = function()
        local filename = _G.macroFileName or "macro.json"
        if readfile and isfile and isfile(filename) then
            local json = readfile(filename)
            loadedMacro = HttpService:JSONDecode(json)
            Rayfield:Notify({Title = "Loaded", Content = "Loaded " .. #loadedMacro .. " actions", Duration = 3})
        else
            Rayfield:Notify({Title = "Error", Content = "File not found", Duration = 3})
        end
    end
})

local RunButton = MacroTab:CreateButton({
    Name = "Run Macro",
    Callback = function()
        if replaying or recording then return end
        if #loadedMacro == 0 then
            local filename = _G.macroFileName or "macro.json"
            if readfile and isfile and isfile(filename) then
                loadedMacro = HttpService:JSONDecode(readfile(filename))
            end
        end
        replaying = true
        Rayfield:Notify({Title = "Running", Content = "Executing macro...", Duration = 2})
        task.spawn(function()
            if autoMap then
                local mapName = _G.mapName or ""
                if mapName ~= "" then
                    for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
                        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (gui.Text and gui.Text:lower():find(mapName:lower()) or gui.Name:lower():find(mapName:lower())) then
                            gui.MouseButton1Click:Fire()
                            task.wait(0.5)
                            break
                        end
                    end
                end
            end
            if applyDifficulty then
                local diffName = _G.diffName or ""
                if diffName ~= "" then
                    for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
                        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (gui.Text and gui.Text:lower():find(diffName:lower()) or gui.Name:lower():find(diffName:lower())) then
                            gui.MouseButton1Click:Fire()
                            task.wait(0.5)
                            break
                        end
                    end
                end
            end
            for _, action in ipairs(loadedMacro) do
                task.wait(action.delay or 0.1)
                simulateTouch(action.x, action.y)
            end
            replaying = false
            Rayfield:Notify({Title = "Done", Content = "Macro completed", Duration = 2})
            if autoLobby then
                task.wait(2)
                TeleportService:Teleport(game.PlaceId, LP)
            end
        end)
    end
})

local AutoReplayToggle = MacroTab:CreateToggle({
    Name = "Auto Replay",
    CurrentValue = false,
    Flag = "AutoReplay",
    Callback = function(Value)
        autoReplay = Value
        if Value then
            task.spawn(function()
                while autoReplay do
                    if not replaying and not recording then
                        if #loadedMacro == 0 then
                            local filename = _G.macroFileName or "macro.json"
                            if readfile and isfile and isfile(filename) then
                                loadedMacro = HttpService:JSONDecode(readfile(filename))
                            end
                        end
                        replaying = true
                        task.spawn(function()
                            if autoMap then
                                local mapName = _G.mapName or ""
                                if mapName ~= "" then
                                    for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
                                        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (gui.Text and gui.Text:lower():find(mapName:lower()) or gui.Name:lower():find(mapName:lower())) then
                                            gui.MouseButton1Click:Fire()
                                            task.wait(0.5)
                                            break
                                        end
                                    end
                                end
                            end
                            if applyDifficulty then
                                local diffName = _G.diffName or ""
                                if diffName ~= "" then
                                    for _, gui in pairs(LP.PlayerGui:GetDescendants()) do
                                        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and (gui.Text and gui.Text:lower():find(diffName:lower()) or gui.Name:lower():find(diffName:lower())) then
                                            gui.MouseButton1Click:Fire()
                                            task.wait(0.5)
                                            break
                                        end
                                    end
                                end
                            end
                            for _, action in ipairs(loadedMacro) do
                                task.wait(action.delay or 0.1)
                                simulateTouch(action.x, action.y)
                            end
                            replaying = false
                            if autoLobby then
                                task.wait(2)
                                TeleportService:Teleport(game.PlaceId, LP)
                            end
                        end)
                    end
                    task.wait(1)
                end
            end)
        end
    end
})

