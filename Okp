-- Record touches (mobile)
UserInputService.TouchTap:Connect(function(touchPositions, processed)
    if recording and not processed then
        local pos = touchPositions[1]
        local x, y = pos.X, pos.Y
        local delay = tick() - startTime
        startTime = tick()
        local unitName = ""
        local guiObjects = LP.PlayerGui:GetGuiObjectsAtPosition(x, y)
        for _, obj in ipairs(guiObjects) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                unitName = obj.Name
                if obj.Text and obj.Text ~= "" then
                    unitName = obj.Text
                end
                break
            end
        end
        table.insert(macro, {
            x = x,
            y = y,
            delay = delay,
            unit = unitName
        })
        Rayfield:Notify({Title = "Recording", Content = "Recorded: " .. #macro .. " | Unit: " .. (unitName ~= "" and unitName or "?"), Duration = 1})
    end
end)

Rayfield:LoadConfiguration()
